#!/usr/bin/env python3
"""Stub engine CLI (claude, opencode, gemini, socat): replays a recorded fixture.

StubSandbox sets STUB_FIXTURE (a file to print, optional) and STUB_EXIT_CODE. Invoked as
`socat` it prints nothing: it binds the TCP-LISTEN:<port> address on 127.0.0.1 and sleeps
until killed, so a port-forward script finds its port open at once.
"""

import os
import re
import socket
import sys
import time
from pathlib import Path


def main() -> int:
    name = Path(sys.argv[0]).name
    if name == "socat":
        for arg in sys.argv[1:]:
            m = re.match(r"TCP-LISTEN:(\d+)", arg)
            if m:
                srv = socket.socket()
                srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
                srv.bind(("127.0.0.1", int(m.group(1))))
                srv.listen(8)
                break
        while True:
            time.sleep(3600)
    fixture = os.environ.get("STUB_FIXTURE")
    if fixture:
        sys.stdout.write(Path(fixture).read_text())
        sys.stdout.flush()
        err = Path(fixture + ".stderr")
        if err.exists():
            sys.stderr.write(err.read_text())
    return int(os.environ.get("STUB_EXIT_CODE", "0"))


if __name__ == "__main__":
    sys.exit(main())
