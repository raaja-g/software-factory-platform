# Copy to .env. An empty value means "use the default".
FACTORY_MODE=personal
# The long-running services refuse to start unless FACTORY_MODE is set explicitly.
FACTORY_IAP_AUDIENCE=
FACTORY_IN_CONTAINER=
FACTORY_API_URL=http://127.0.0.1:7080
# Personal mode credential: this value, else the contents of FACTORY_API_TOKEN_FILE.
FACTORY_API_TOKEN=
FACTORY_API_TOKEN_FILE=secrets/api_token
FACTORY_LOCAL_USER=local
FACTORY_ALLOWED_HOSTS=127.0.0.1,localhost
# Dashboard's public origin, e.g. https://factory.example.com
# The dashboard's address when it is not the API's (the compose stack serves it from its own
# container on 7000). Dashboard links and the API's accepted origins use it.
FACTORY_PUBLIC_URL=
# false when a separate UI container serves the dashboard; `factory serve` serves it by default
FACTORY_SERVE_WEB=true
# The dashboard's login (personal mode). Username: leave empty for "local". Password: at least 8
# characters; leave empty to use the API token in secrets/api_token.
FACTORY_LOGIN_USER=
FACTORY_LOGIN_PASSWORD=
# Days the dashboard stays logged in (the session cookie's lifetime)
FACTORY_SESSION_DAYS=30
FACTORY_DATABASE_URL=postgresql+psycopg://factory@127.0.0.1:7432/factory
FACTORY_DATABASE_PASSWORD_FILE=
FACTORY_DEFINITION=
FACTORY_DEFINITION_REF=main
FACTORY_LOG_LEVEL=INFO
FACTORY_WORKER_ID=
FACTORY_ALLOWED_PROVIDER_HOSTS=generativelanguage.googleapis.com,api.groq.com,openrouter.ai
FACTORY_ALLOWED_LOCAL_MODEL_HOSTS=host.docker.internal
FACTORY_ALLOWED_IMAGE_PREFIXES=swfactory/
# Folder on your Mac that holds your repos, e.g. /Users/you/work (required by `make up`).
FACTORY_HOST_REPOS_ROOT=
# Your definition repo, mounted read-write at /definition (required by `make up`).
FACTORY_DEFINITION_PATH=
FACTORY_DB_POOL_SIZE=5
FACTORY_DB_MAX_OVERFLOW=5
FACTORY_CHECKPOINTER_POOL_MAX=4
# 0 = none (the api container sets 30)
FACTORY_DB_STATEMENT_TIMEOUT_S=0
FACTORY_HOST_HOME=
FACTORY_ARTIFACTS_DIR=/var/lib/factory/artifacts
FACTORY_DOCKER_HOST=tcp://docker-proxy:2375
FACTORY_REPOS_DIR=/repos
FACTORY_MAX_BUNDLE_MB=2048
FACTORY_GITOPS_TIMEOUT_S=900
FACTORY_GITOPS_NETWORK=gitops-net
FACTORY_GITOPS_IMAGE=swfactory/runner:0.1.0
FACTORY_DISK_HIGH_WATER_PCT=85
FACTORY_EXEC_OUTPUT_MAX_BYTES=2000000
# Must start with sk-
LITELLM_MASTER_KEY=
# Back it up; it cannot be rotated.
LITELLM_SALT_KEY=
LITELLM_DB_PASSWORD=
# Digest-pinned image (M0 must confirm): ghcr.io/berriai/litellm-non_root@sha256:...
LITELLM_IMAGE=
GOOGLE_CLOUD_PROJECT=
# Create with: gcloud auth application-default login --impersonate-service-account=factory-gateway@<project>.iam.gserviceaccount.com
# That account holds only roles/aiplatform.user, so the gateway never holds your own GCP access.
GCLOUD_ADC_FILE=
FACTORY_GATEWAY_URL=
FACTORY_GATEWAY_SANDBOX_URL=
# Where the worker writes the rendered LiteLLM config and restarts the gateway when the definition
# changes. Set by compose (/gateway-config/litellm.yaml); leave empty for a worker run on the host
# (then: docker compose run --rm gateway-init && docker compose restart gateway).
FACTORY_GATEWAY_CONFIG=
# Webhook for notices (Slack-style {"text": ...}); empty means log only. Or FACTORY_NOTIFY_WEBHOOK_URL_FILE.
FACTORY_NOTIFY_WEBHOOK_URL=
FACTORY_NOTIFY_WEBHOOK_URL_FILE=
FACTORY_NOTIFY_WAITING_AFTER_H=4
# Package mirror (M7.7c). Read-only token for each `token` registry named in factory.yaml; only the
# pkg-mirror-auth sidecar reads this file. Name: REGISTRY_<NAME>_TOKEN (the registry's `credential`).
# REGISTRY_ACME_PY_TOKEN=
# Digest-pinned images (M0 S13 must confirm): verdaccio/verdaccio@sha256:... and python@sha256:...
PKG_MIRROR_NPM_IMAGE=
PKG_MIRROR_PYPI_IMAGE=
FACTORY_SANDBOX_ATTACH=gateway-edge,pkg-mirror
FACTORY_REGISTRY_ENV_FILE=
FACTORY_REGISTRY_ADC_FILE=
FACTORY_MIRROR_OUT_DIR=/pkg-auth
# GitHub (M8.1). Server mode: a GitHub App (client id + private key file; only the orchestrator reads the key).
# Personal mode only: a fine-grained PAT in FACTORY_GITHUB_TOKEN (refused in server mode).
FACTORY_GITHUB_APP_CLIENT_ID=
FACTORY_GITHUB_APP_PRIVATE_KEY_FILE=
FACTORY_GITHUB_WEBHOOK_SECRET=
FACTORY_GITHUB_TOKEN=
FACTORY_GITHUB_POLL_S=60
# Token broker (M8.10): the orchestrator serves it on core-net; the api asks it for narrow GitHub tokens.
FACTORY_BROKER_URL=http://orchestrator:8091
FACTORY_BROKER_TOKEN_FILE=
# Laya router (M11.1, optional, profile `laya`): docker compose --profile laya up -d --build router
# LAYA_API_KEY is the router's bearer key (make it random); the router refuses to start without it.
FACTORY_LAYA_URL=
# Where `factory laya export` writes CSVs when you run it on the host (default var/laya); compose sets its own.
FACTORY_LAYA_EXPORT_DIR=
LAYA_API_KEY=
